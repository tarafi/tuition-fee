<%- include('partials/head') %>
<h1>Account</h1>
<form method="post" action="/account" class="card form">
  <h2>Change password</h2>
  <% if (error) { %><p class="alert bad"><%= error %></p><% } %>
  <% if (msg) { %><p class="alert good"><%= msg %></p><% } %>
  <label>Current password <input type="password" name="current" required autocomplete="current-password"></label>
  <label>New password <input type="password" name="next" required minlength="6" autocomplete="new-password"></label>
  <button class="btn">Save</button>
</form>
<div class="card row-between">
  <a href="/batches">Manage batches</a>
  <form method="post" action="/logout"><button class="btn btn-ghost">Log out</button></form>
</div>
<%- include('partials/foot') %>
