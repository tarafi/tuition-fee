PORT=3000
CENTER_NAME=My Tuition Centre
# Currency prefix shown before amounts, e.g. "₹", "SAR ", "$"
CURRENCY=₹
# Number formatting locale (en-IN groups as 1,00,000; en-US as 100,000)
LOCALE=en-IN
# Password for the "admin" user, only used the very first time the app starts
ADMIN_PASSWORD=change-me-now
# Set to 1 once the site is served over HTTPS (behind Nginx + Let's Encrypt)
COOKIE_SECURE=0
# Timezone used for "today" (fees, attendance)
TZ=Asia/Kolkata
